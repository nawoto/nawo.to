{
  "name": "nawo.to",
  "type": "module",
  "version": "1.3.0",
  "license": "MIT",
  "author": "西村直人 (Naoto Nishimura)",
  "homepage": "https://nawo.to",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/copy-article-images.js --cleanup",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:check": "eslint src/ --max-warnings 0",
    "quality": "node scripts/check-code-quality.js",
    "format:auto": "node scripts/format-code.js",
    "duplicate": "jscpd src/",
    "duplicate:report": "jscpd src/ --reporters html,console",
    "generate-favicon": "node scripts/generate-favicon.js",
    "generate-og-images": "node scripts/generate-og-images-astro.js",
    "generate-backtrace-og": "node scripts/generate-backtrace-og.js",
    "new-article": "node scripts/new-article.js",
    "drafts": "node scripts/list-drafts.js",
    "deploy": "npm run build && npx gh-pages -d dist --dotfiles",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "precommit": "node scripts/cleanup-images.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/titillium-web": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "astro-seo": "^1.1.0",
    "date-fns": "^4.4.0",
    "marked": "^18.0.9",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-link-card-plus": "^0.8.0",
    "remark-toc": "^9.0.0",
    "satori": "^0.29.0",
    "simple-icons": "^16.28.0",
    "typescript-eslint": "^8.66.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.14",
    "prettier": "^3.9.6",
